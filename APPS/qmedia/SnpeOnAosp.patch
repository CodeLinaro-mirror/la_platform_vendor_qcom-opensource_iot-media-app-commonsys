 res_dir := res $(LOCAL_PATH)/res
@@ -15,6 +59,9 @@ LOCAL_SRC_FILES += java/org/codeaurora/qmedia/MediaCodecRecorder.java
 LOCAL_SRC_FILES += java/org/codeaurora/qmedia/PresentationBase.java
