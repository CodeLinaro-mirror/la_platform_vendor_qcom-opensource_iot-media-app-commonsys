    <string name="detection_audio_doa_threshold_high_description">The detection threshold which is used to detect when the speaker start speaking. It is related to detection_audio_doa_list_size. (apply only for "Internal audio filter" filter_type)</string>
    <string name="detection_audio_doa_threshold_low">Detection hysteresis low value</string>
